{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",

  // 静态前端：public/ 下的文件由 Cloudflare 直接分发，不消耗 Worker 请求额度
  "assets": {
    "directory": "./public"
  },

  // ⚠️ 抓取已下沉到本地（scripts/daily_sync.py），云端 cron 已移除（CHG-04）。
  // 原因：TreasuryDirect 的 F5 只在 TLS 握手层丢弃来自 Cloudflare 网络的连接。
  //   诊断实测（/api/diag 2026-11-27）：treasury_http 302/149ms 通、
  //   treasury_https 超时/525、tls12_only 200/275ms（排除协议不兼容）。
  //   即 TCP/IP 与服务器都正常，仅 TLS 握手被定向拒绝，Workers 无法自救。
  // 保留一个注定失败的 cron 只会每天写一条 failed，掩盖真实健康状态。
  // 若上游将来解封，取消下面注释即可恢复云端抓取。
  // "triggers": {
  //   "crons": ["5 1 * * *"]
  // },

  // database_id 需要先执行 npm run db:create 后回填
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily_tracker",
      "database_id": "80d7ee7d-a4d3-4e91-a7d9-3d056f07a13c"
    }
  ],

  "observability": {
    "enabled": true
  }
}
